{
  "name": "agy-pulse",
  "version": "1.0.0",
  "description": "Context window, prompt cache, cost, and TTFT/TPS panel for Google Antigravity, running as a native zero-dependency sidecar.",
  "type": "module",
  "bin": {
    "agy-pulse": "./install.mjs"
  },
  "scripts": {
    "test": "node --test",
    "start": "node sidecars/context-monitor/server.mjs",
    "setup": "node install.mjs",
    "status": "node install.mjs --status",
    "uninstall-sidecar": "node install.mjs --uninstall"
  },
  "keywords": [
    "antigravity",
    "google-antigravity",
    "antigravity-plugin",
    "antigravity-sidecar",
    "gemini",
    "claude",
    "context-window",
    "token-monitor",
    "tps",
    "ttft",
    "prompt-caching"
  ],
  "author": "evenluo",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/evenluo/agy-pulse.git"
  },
  "bugs": {
    "url": "https://github.com/evenluo/agy-pulse/issues"
  },
  "homepage": "https://github.com/evenluo/agy-pulse#readme",
  "engines": {
    "node": ">=20"
  },
  "files": [
    "plugin.json",
    "install.mjs",
    "assets/",
    "docs/",
    "sidecars/",
    "skills/",
    "README.md",
    "README_CN.md",
    "CHANGELOG.md",
    "LICENSE"
  ]
}
